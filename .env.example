# Copy this file to .env and fill in your real values.
# DO NOT commit the real .env file — it is gitignored.

# Supabase credentials (from your Supabase project dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Server port
PORT=5000

# Google AI — text embeddings (required for semantic search)
# Get your key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq — LLM chat completions (required for AI chat, quiz & flashcard generation)
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
